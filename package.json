{
  "name": "wanas",
  "version": "1.0.0",
  "description": "وَنَس — شموع وعطور منزلية من سوهاج | Bilingual candle storefront (AR/EN, RTL/LTR)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "sync:products": "tsx tools/sync-products.ts",
    "optimize:images": "tsx tools/optimize-images.ts",
    "validate:data": "tsx tools/validate-data.ts",
    "prepare": "husky install"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.13.0",
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitest/coverage-v8": "^2.1.9",
    "axe-core": "^4.14.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.0.11",
    "jsdom": "^30.1.3",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2",
    "sharp": "^0.33.4",
    "svgo": "^4.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.3.4",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-image-optimizer": "^1.1.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.1"
}
